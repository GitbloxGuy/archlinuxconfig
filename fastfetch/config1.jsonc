{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": ".config/fastfetch/.asciart1.txt",
    "color":{
     "1": "#a19c08",

     "2": "#258a07"
    },

    "padding": {
      "down": 100, 
      "right": 5
     },
  },


  "display": {
"key": {
"type": "string",
"case": "lower"
},

"color": {
"output": "#258a07",
"keys": "#a19c08",
"title": "#a19c08"
    },

"separator": "   "
  },


  "modules": [
    "title",
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
    "type": "cpu",
    "key": "cpu",
    "temp": true,
    },
    {
    "type": "gpu",
    "key": "gpu",
    "temp": true
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{1}/{2} ({3})"
    },
    {
      "type": "battery",
      "keyIcon": "",
      "temp": true,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },

    "break",
    {
     // "type": "colors",
     // "symbol": "circle"
    }
  ]
}

